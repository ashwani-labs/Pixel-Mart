# Copy to pixelmart-setup/.env — full guide: pixelmart-setup/SETUP.md

# MySQL
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=pixelmart-db
MYSQL_USER=root
MYSQL_PASSWORD=root

# JWT (auth-service) — change in production
JWT_SECRET=change-me-to-a-long-random-secret-at-least-256-bits
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# Storage (catalog-service)
STORAGE_TYPE=local
STORAGE_LOCAL_PATH=./data/uploads

# S3 profile (catalog-service)
# STORAGE_TYPE=s3
# AWS_REGION=ap-south-1
# AWS_S3_BUCKET=pixelmart-media
# AWS_S3_PREFIX=pixelmart
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# SMTP (notification-service — set in .env, never commit real passwords)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
