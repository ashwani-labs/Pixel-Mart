# Copy to pixelmart-setup/.env for local Docker — full guide: pixelmart-setup/SETUP.md

# ---------------------------------------------------------------------------
# Spring profiles (see application.yml in each service)
# ---------------------------------------------------------------------------
# local  → application-local.yml  → Docker MySQL (port 3307 from host, 3306 in compose)
# dev    → application-dev.yml    → TiDB Cloud (port 4000, SSL)
#
# Switch profile in each service's application.yml:
#   spring.profiles.active: local   # or dev
# Or override via env / IntelliJ: SPRING_PROFILES_ACTIVE=dev

# ---------------------------------------------------------------------------
# TiDB Cloud — dev profile (IntelliJ or Render)
# ---------------------------------------------------------------------------
DB_HOST=your-cluster.tidbcloud.com
DB_PORT=4000
DB_USERNAME=your-tidb-username
DB_PASSWORD=your-tidb-password

# ---------------------------------------------------------------------------
# Local Docker MySQL — local profile (defaults in application-local.yml)
# ---------------------------------------------------------------------------
# DB_HOST=localhost
# DB_PORT=3307
# DB_USERNAME=root
# DB_PASSWORD=root
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=pixelmart-db

# ---------------------------------------------------------------------------
# JWT (auth-service + gateway)
# ---------------------------------------------------------------------------
JWT_SECRET=change-me-to-a-long-random-secret-at-least-256-bits
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# ---------------------------------------------------------------------------
# Inter-service URLs (Render dev profile — gateway + inter-service calls)
# ---------------------------------------------------------------------------
# AUTH_SERVICE_URL=https://pixelmart-auth.onrender.com
# CATALOG_SERVICE_URL=https://pixelmart-catalog.onrender.com
# ORDER_SERVICE_URL=https://pixelmart-order.onrender.com
# NOTIFICATION_SERVICE_URL=https://pixelmart-notification.onrender.com

# ---------------------------------------------------------------------------
# Storage (catalog-service)
# ---------------------------------------------------------------------------
STORAGE_TYPE=local
STORAGE_LOCAL_PATH=./data/uploads

# S3 (catalog-service on Render)
# STORAGE_TYPE=s3
# AWS_REGION=ap-south-1
# AWS_S3_BUCKET=pixelmart-media
# AWS_S3_PREFIX=pixelmart
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ---------------------------------------------------------------------------
# SMTP (notification-service)
# ---------------------------------------------------------------------------
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=

# ---------------------------------------------------------------------------
# Frontend (Vercel)
# ---------------------------------------------------------------------------
# VITE_API_BASE_URL=https://pixelmart-gateway.onrender.com/api

# ---------------------------------------------------------------------------
# Razorpay (order-service — optional live payments)
# RAZORPAY_KEY_ID=rzp_test_...
# RAZORPAY_KEY_SECRET=...
