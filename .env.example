# Copy to pixelmart-setup/.env for local Docker — full guide: pixelmart-setup/SETUP.md
# For TiDB Cloud / Render production, set these in your hosting dashboard (never commit real secrets).

# ---------------------------------------------------------------------------
# TiDB Cloud (production — used by all Spring Boot microservices)
# ---------------------------------------------------------------------------
DB_HOST=your-cluster.tidbcloud.com
DB_PORT=4000
DB_NAME=pixelmart-db
DB_USERNAME=your-tidb-username
DB_PASSWORD=your-tidb-password
DB_USE_SSL=true

# ---------------------------------------------------------------------------
# Local Docker MySQL only (docker-compose mysql service)
# ---------------------------------------------------------------------------
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=pixelmart-db

# ---------------------------------------------------------------------------
# JWT (auth-service + gateway) — change in production
# ---------------------------------------------------------------------------
JWT_SECRET=change-me-to-a-long-random-secret-at-least-256-bits
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# ---------------------------------------------------------------------------
# Inter-service URLs (Render / production — set to internal or public service URLs)
# ---------------------------------------------------------------------------
# AUTH_SERVICE_URL=https://pixelmart-auth.onrender.com
# CATALOG_SERVICE_URL=https://pixelmart-catalog.onrender.com
# ORDER_SERVICE_URL=https://pixelmart-order.onrender.com
# NOTIFICATION_SERVICE_URL=https://pixelmart-notification.onrender.com

# ---------------------------------------------------------------------------
# Storage (catalog-service)
# ---------------------------------------------------------------------------
STORAGE_TYPE=local
STORAGE_LOCAL_PATH=./data/uploads

# S3 profile (catalog-service — recommended for Render)
# STORAGE_TYPE=s3
# AWS_REGION=ap-south-1
# AWS_S3_BUCKET=pixelmart-media
# AWS_S3_PREFIX=pixelmart
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ---------------------------------------------------------------------------
# SMTP (notification-service)
# ---------------------------------------------------------------------------
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=

# ---------------------------------------------------------------------------
# Frontend (Vercel)
# ---------------------------------------------------------------------------
# VITE_API_BASE_URL=https://pixelmart-gateway.onrender.com/api
